# Firebase Configuration
# These are PUBLIC keys and safe to include in version control
# For a production app, you might want to use Firebase's recommended approach

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ⚠️ SECURITY WARNING ⚠️
# NEVER store service account keys or other sensitive credentials in .env files
# Service account keys should be:
# 1. Stored in environment variables on the server
# 2. Used with Firebase Admin SDK
# 3. Never committed to version control
# 4. Rotated regularly
#
# Example of what NOT to do:
# GOOGLE_APPLICATION_CREDENTIALS= # ❌ Never put service account keys here
# FIREBASE_ADMIN_SDK_KEY= # ❌ Never put admin keys here